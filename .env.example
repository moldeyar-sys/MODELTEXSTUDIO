# ============================================================
# Moldey Global - Variables de entorno (ejemplo)
# Copiá este archivo a ".env" y completá los valores reales.
# NO subas ".env" al repositorio.
# ============================================================

# --- Supabase (OBLIGATORIAS) ---
# VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY son públicas, van al frontend.
# SUPABASE_SERVICE_ROLE_KEY es SECRETA de servidor (sin prefijo VITE_): la
# usan api/chat.ts, api/create-preference.ts, api/mp-webhook.ts,
# api/guest-order.ts y api/utils.ts (notify-order/notify-buyer-paid) para
# escribir/leer sin pasar por RLS. Auditoría 2026-09-16: faltaba documentada
# acá aunque el código siempre la leyó.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago (OPCIONAL - solo backend) ---
# MP_ACCESS_TOKEN: Access Token de producción (api/create-preference.ts y
# api/mp-webhook.ts). El nombre tiene que ser EXACTO — antes este archivo
# documentaba "MERCADO_PAGO_ACCESS_TOKEN", que el código nunca leyó.
MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET (opcional pero recomendada): "Firma secreta" del webhook,
# en Mercado Pago > Tu integración > Webhooks. Sin configurar, el webhook
# sigue funcionando igual de seguro para aprobar pagos (nunca confía en la
# notificación, siempre reconsulta a la API de MP), pero cualquiera puede
# llamar a la URL del webhook para forzar esa consulta o sondear el estado de
# un pago ajeno. Con la key configurada, una notificación sin firma válida se
# corta antes de tocar la API de MP.
MP_WEBHOOK_SECRET=

# --- Otras pasarelas (reservadas, hoy sin uso en el código) ---
# Ningún archivo de api/ ni src/ las lee todavía (PayPal/Payoneer/Wise/
# Binance hoy son enlaces/QR manuales cargados en el panel admin, tabla
# payment_settings). Dejarlas en blanco no rompe nada.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
STRIPE_SECRET_KEY=

# --- Cloudflare R2 (OPCIONAL - imágenes del catálogo, ver api/utils.ts?action=upload-image) ---
# SECRETOS de servidor, sin prefijo VITE_ salvo la URL pública. Sin
# configurar, el admin no puede subir fotos nuevas (siguen funcionando las
# que ya estén cargadas).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
VITE_R2_PUBLIC_URL=

# --- Analytics y motores de búsqueda (OPCIONALES - frontend) ---
# Sin configurar, el sitio funciona igual: no se carga GA4 ni se manda el
# meta de verificación (queda vacío, Google simplemente no verifica).
# GA4: Measurement ID de https://analytics.google.com (Admin > Flujos de datos).
VITE_GA_MEASUREMENT_ID=
# Search Console: método "Etiqueta HTML" en Search Console > Verificar propiedad.
# Solo el content del meta, sin el tag completo (ej: "AbCdEf123...").
VITE_GSC_VERIFICATION=

# --- IndexNow (OPCIONAL - solo backend, ver api/utils.ts?action=indexnow) ---
# SECRETO de servidor, sin prefijo VITE_. Cualquier string propio sirve como
# key (ej: un UUID); se expone solo vía /api/utils?action=indexnow-key, que
# es el mecanismo que exige el protocolo IndexNow para validar el dominio.
INDEXNOW_KEY=

# --- Notificaciones (OPCIONALES - solo backend, ver api/utils.ts) ---
# Sin configurar, el sitio sigue funcionando: simplemente no se manda el
# aviso de WhatsApp/email de una compra nueva (api/utils.ts?action=notify-order)
# ni el mail de "tu pedido ya está listo" al comprador sin cuenta
# (api/utils.ts?action=notify-buyer-paid, y el aviso automático del webhook).
#
# Resend (mail transaccional, https://resend.com):
RESEND_API_KEY=
# A qué mail del dueño llega el aviso de compra nueva:
NOTIFY_EMAIL=
# Remitente que ve el comprador (ej: "Modeltex <pedidos@modeltex.com.ar>").
# Sin configurar, cae a "Modeltex <onboarding@resend.dev>" (funciona pero es
# el dominio de prueba de Resend, no el propio).
NOTIFY_FROM=
# CallMeBot (WhatsApp gratis vía https://www.callmebot.com/blog/free-api-whatsapp-messages/):
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# --- Asistente de IA (OPCIONAL - solo backend, ver api/chat.ts, api/embed-catalog.ts, api/generate-descriptions.ts) ---
# Sin OPENROUTER_API_KEY, el chat responde derivando a WhatsApp y las
# herramientas de IA del panel admin (embeddings, descripciones) no funcionan.
# Cuenta en https://openrouter.ai — configurarle un límite de gasto mensual
# ahí es la protección real contra un uso excesivo, no algo que se resuelva
# desde el código.
OPENROUTER_API_KEY=
# Modelo de texto (chat y descripciones). Por defecto: openai/gpt-4o-mini
OPENROUTER_MODEL=
# Modelo de embeddings (búsqueda semántica). Por defecto: openai/text-embedding-3-small
OPENROUTER_EMBED_MODEL=
